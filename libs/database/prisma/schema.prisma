generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
}

model JiraIssue {
  id             String  @id @default(uuid())
  key            String  @unique
  summary        String?
  status         String?
  issueType      String? @map("issue_type")
  assigneeEmail  String? @map("assignee_email")
  priority       String?
  epicKey        String? @map("epic_key")
  parentIssueKey String? @map("parent_issue_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   JiraIssue?  @relation("ParentIssue", fields: [parentIssueKey], references: [key])
  children JiraIssue[] @relation("ParentIssue")

  @@index([parentIssueKey])
  @@index([key])
  @@map("jira_issue")
}
