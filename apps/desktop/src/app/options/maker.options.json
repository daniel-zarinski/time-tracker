{
  "$schema": "../../../../../node_modules/nx-electron/src/validation/maker.schema.json",
  "asar": true,
  "extraResources": [
    {
      "from": "dist/apps/desktop/prisma",
      "to": "prisma",
      "filter": ["!dev.db"]
    },
    {
      "from": "dist/apps/desktop/prisma.config.ts",
      "to": "prisma.config.ts"
    }
  ],
  "files": [
    {
      "from": "../../node_modules/.prisma",
      "to": "node_modules/.prisma",
      "filter": ["**/*"]
    }
  ],
  "mac": {
    "target": ["zip"],
    "icon": "apps/desktop/src/assets/stopwatch.png",
    "identity": null,
    "extraResources": [
      {
        "from": "node_modules/@prisma/engines/schema-engine-darwin-arm64",
        "to": "schema-engine-darwin-arm64"
      }
    ]
  },
  "win": {
    "target": ["nsis"],
    "icon": "apps/desktop/src/assets/icon.ico",
    "requestedExecutionLevel": "asInvoker",
    "extraResources": [
      {
        "from": "node_modules/@prisma/engines/schema-engine-windows.exe",
        "to": "schema-engine-windows.exe"
      }
    ]
  },
  "publish": {
    "provider": "github",
    "owner": "daniel-zarinski",
    "repo": "time-tracker"
  },
  "productName": "TimeTracker"
}
