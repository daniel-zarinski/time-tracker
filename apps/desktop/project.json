{
  "name": "desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/desktop/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx-electron:build",
      "dependsOn": ["database:generate"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/desktop",
        "main": "apps/desktop/src/main.ts",
        "tsConfig": "apps/desktop/tsconfig.app.json",
        "assets": [
          "apps/desktop/src/assets",
          {
            "glob": "**/*",
            "input": "libs/database/prisma",
            "output": "prisma"
          },
          {
            "glob": "prisma.config.ts",
            "input": "libs/database",
            "output": "."
          }
        ],
        "externalDependencies": [
          "electron",
          "@prisma/client",
          ".prisma/client",
          "@prisma/adapter-better-sqlite3",
          "better-sqlite3"
        ]
      },
      "configurations": {
        "production": {
          "optimization": true,
          "extractLicenses": true,
          "inspect": false,
          "fileReplacements": [
            {
              "replace": "apps/desktop/src/environments/environment.ts",
              "with": "apps/desktop/src/environments/environment.prod.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "nx-electron:execute",
      "options": {
        "buildTarget": "desktop:build"
      },
      "dependsOn": ["^typecheck"]
    },
    "package": {
      "executor": "nx-electron:package",
      "options": {
        "name": "desktop",
        "frontendProject": "renderer",
        "sourcePath": "dist/apps",
        "outputPath": "dist/packages",
        "prepackageOnly": true
      }
    },
    "make": {
      "executor": "nx-electron:make",
      "options": {
        "name": "desktop",
        "frontendProject": "renderer",
        "sourcePath": "dist/apps",
        "outputPath": "dist/executables"
      },
      "dependsOn": ["^build:production"]
    }
  }
}
