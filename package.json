{
  "name": "time-tracker",
  "version": "0.0.0",
  "description": "Electron desktop time tracker application",
  "license": "MIT",
  "author": "Daniel Zarinski <daniel.zarinski@gmail.com>",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "clean": "nx reset && rm -rf dist .nx/cache node_modules/.cache/nx",
    "add:component": "npx shadcn@latest add",
    "build": "nx run-many --target=build,typecheck --all",
    "build:production": "nx run-many --target=build --all --configuration=production",
    "build:renderer": "nx build renderer --configuration=production",
    "build:desktop": "nx build desktop --configuration=production",
    "build:ui": "nx typecheck ui",
    "dev": "nx run-many --targets=serve --projects=renderer,desktop --parallel",
    "serve:renderer": "nx serve renderer",
    "serve:desktop": "nx serve desktop",
    "test:renderer": "nx test renderer",
    "test:desktop": "nx test desktop",
    "package": "nx run desktop:package",
    "make": "nx run desktop:make"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/daniel-zarinski/time-tracker.git"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nx/eslint": "22.5.3",
    "@nx/eslint-plugin": "22.5.3",
    "@nx/jest": "22.5.3",
    "@nx/js": "22.5.3",
    "@nx/react": "22.5.3",
    "@nx/vite": "22.5.3",
    "@nx/web": "22.5.3",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.17",
    "@swc/helpers": "0.5.19",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "25.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/ui": "^4.0.0",
    "ajv": "^8.0.0",
    "date-fns": "^4.1.0",
    "electron": "^40.6.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^30.0.2",
    "jest-environment-node": "^30.0.2",
    "jiti": "2.6.1",
    "jsdom": "~28.1.0",
    "jsonc-eslint-parser": "^3.1.0",
    "nx": "22.5.3",
    "nx-electron": "^22.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.0",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.2",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "~4.5.0",
    "vitest": "^4.0.0",
    "webpack-node-externals": "^3.0.0"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-better-sqlite3": "^7.4.1",
    "@prisma/client": "^7.4.2",
    "@tanstack/react-query": "^5.90.21",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.575.0",
    "motion": "^12.34.3",
    "prisma": "^7.4.2",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^4.6.5",
    "react-router-dom": "6.30.3",
    "react-use-measure": "^2.1.7",
    "shadcn": "^3.8.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.0-canary.20260125T215152",
    "zustand": "^5.0.11"
  },
  "overrides": {
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "minimatch@>=10.0.0": "10.2.4"
  }
}
